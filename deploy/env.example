# Copy to deploy/.env (gitignored) and fill in. bootstrap.sh generates the
# secrets for you and asks for the Token Factory key.

# Public name for Caddy's certificate. <ip with dashes>.sslip.io needs no DNS.
AIRLOCK_HOST=203-0-113-7.sslip.io

# Generated secrets (openssl rand -hex 32 / 64).
CONTROL_DATABASE_PASSWORD=
SECRET_KEY_BASE=
AGENTKIT_AUDIT_KEY=
AIRLOCK_HOOK_SECRET=
# Reviewers sign in on the Frameline tab with this token.
AIRLOCK_REVIEW_TOKEN=

# Nebius Token Factory: Nemotron models for the agents, labels and diagnosis.
NEBIUS_TOKEN=
NEBIUS_PROJECT_ID=
# Token Factory Sandboxes: false runs checks on the local runner and records
# evidence re-runs as skipped. Set to true once Sandboxes access is granted.
NEBIUS_SANDBOX=false

# 1 creates the demo repository (Frameline) on first start.
AIRLOCK_SEED_DEMO=1
# Job threads: one per parallel agent, plus routing, merge queue and renders.
JOB_THREADS=8

# Postgres memory. On Oracle's 12 GB Arm VM: 3GB and 6GB (see deploy/oracle.md).
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
